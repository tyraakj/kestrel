{
  "name": "kestrel",
  "version": "0.1.0",
  "description": "Sovereign Autonomous DeFi Agent & 10ms Pre-Flight Simulation Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:evals": "vitest run tests/unit",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check:suppressions": "bash scripts/check-suppressions.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@ledgerhq/hw-transport-node-hid": "^6.33.5",
    "dotenv": "^16.6.1",
    "ink": "^4.4.1",
    "react": "^18.3.1",
    "viem": "^2.56.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
